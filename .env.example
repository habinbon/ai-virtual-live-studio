# Sao chép thành .env ở gốc dự án và điền giá trị. Không commit file .env.
# Để trống tất cả = chế độ demo ghi rõ (LLM mock + TTS SpeechSynthesis demo).
# Không ghi key thật vào file này.

PORT=3001
# HOST: 127.0.0.1 = chỉ máy của bạn (mặc định, an toàn). Khi deploy lên Render
# thì render.yaml đặt HOST=0.0.0.0 để Render nhận kết nối bên ngoài.
HOST=127.0.0.1
# TRUST_PROXY=1 chỉ đặt trên máy chủ đứng sau proxy (Render). Để trống ở máy local.
TRUST_PROXY=

# Mật khẩu quản trị trang #/admin (đăng nhập bằng cookie HttpOnly, token HMAC).
# BẮT BUỘC khi đưa lên mạng: không đặt mật khẩu + NODE_ENV=production thì mọi
# route quản trị đều bị chặn. Ở máy local không đặt mật khẩu thì trang quản trị
# vẫn mở như trước, kèm cảnh báo. Đặt mật khẩu mạnh, khác mọi mật khẩu khác.
ADMIN_PASSWORD=
# Khóa ký token phiên quản trị (tùy chọn; không đặt thì suy ra từ ADMIN_PASSWORD).
ADMIN_SECRET=

# LLM OpenAI-compatible (ví dụ: OpenAI hoặc provider tương đương)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
CHARACTER_SYSTEM_PROMPT=

# Chế độ cô giáo AI — chuyên gia tâm lý (mặc định trong code đã là tâm lý học)
# Điền để tinh chỉnh, ví dụ: TEACHER_SUBJECT=Tâm lý học, TEACHER_LEVEL=Học sinh cấp 2
TEACHER_SUBJECT=
TEACHER_LEVEL=
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.7

# TTS ElevenLabs (streaming phía server; giọng mặc định Linh Sensei, eleven_v4, vi — đã chốt 2026-11-01)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=7iUjM4919D20JYbu4ISi

# TTS VoiceTube (async job + polling, opt-in; xem server/src/adapters/voicetube.js)
# LƯU Ý: key trong Secure Vault của Muse KHÔNG tự chảy sang server này.
# Người vận hành server phải nhập key của cùng tài khoản vào .env của server
# trên máy deploy. Không commit file .env.
# TTS_PROVIDER=voicetube để ép dùng VoiceTube; để trống = ưu tiên ElevenLabs,
# nếu ElevenLabs chưa có key thì dùng VoiceTube khi đã cấu hình.
TTS_PROVIDER=
VOICETUBE_API_KEY=
VOICETUBE_VOICE_ID=
VOICETUBE_SPEED=0.9
